	<text>	
		<body>
			<head>
				<num ref="#n21">XXI</num>
			</head>
			<lg type="poem">
				<lg type="stanza">
					<l xml:id="1"><seg ana="#met">Cenerentola che non piange</seg>, l'ultimo Canto,</l>
					<l xml:id="2">- il <num ref="#n21">Ventunesimo</num> - rimasto</l>
					<l xml:id="3"><seg ana="#pers">tutto solo</seg> in <seg ana="#obj">cucina</seg> ad <seg ana="#pers">ascoltare</seg></l>
					<l xml:id="4">accanto al <seg ana="#obj">fuoco</seg> il <seg ana="#onom">borbottio</seg> <seg ana="#inter">(sirena!)</seg></l>
					<l xml:id="5">di qualcosa che <seg ana="#onom">bolle</seg>, ci <seg ana="#pers">chiede</seg>:</l>
					<l xml:id="6">"Cos'è che tiene insieme e fa che non si perda oltre confine</l>
					<l xml:id="7">questo <seg ana="#met">cosmo di <seg ana="#obj">pasta</seg> e di <seg ana="#obj">verdura</seg></seg>,</l> 
					<l xml:id="8">questo <seg ana="#met">battesimo di <seg ana="#obj">acqua</seg> e <seg ana="#obj">olio</seg>, roteante</seg>?</l>
					<l xml:id="9">O è qualcosa che non si vede? O è la <seg ana="#obj">pentola</seg> e basta?</l>
				</lg>
				<lg type="stanza">
					<l xml:id="10"> <seg ana="#pers">Cantano</seg>, risospinte, <seg ana="#obj">le cipolle</seg>,</l> 
					<l xml:id="11">- è così che cantano <seg ana="#met">le figlie del sole</seg>,</l> 
					<l xml:id="12"> occhi rotondi, <seg ana="#met">occhi d'oro</seg>, nel chiuso di una stanza -</l> 
					<l xml:id="13">e <seg ana="#obj">le patate</seg> e le <seg ana="#obj">carote</seg> <seg ana="#pers">cantano</seg>, dal fondo</l> 
					<l xml:id="14">di <seg ana="#met">vortici bui arancio</seg>, e dalle <seg ana="#obj">conchiglie</seg> esce un suono,</l> 
					<l xml:id="15"><seg ana="#pers">stridono</seg>, ancora, prima di <seg ana="#pers">convincersi</seg></l> 
					<l xml:id="16">anche loro, alla prova</l> 
					<l xml:id="17">della <seg ana="#obj">danza</seg>. Assomiglia,</l> 
					<l xml:id="18">questo mondo, <seg ana="#inter">se è un mondo</seg>,</l> 
					<l xml:id="19">al fuoco che lo muove.</l> 
				</lg>
				<lg type="stanza">	
					<l xml:id="20">Il <num ref="#n21">Ventunesimo</num> - il Canto del <seg ana="#obj">Cuoco</seg> - </l>
					<l xml:id="21"><seg ana="#pers">ha visto</seg> abbastanza, <seg ana="#pers">ride</seg>.</l> 
					<l xml:id="22"><seg ana="#pers">Ridono</seg> anche gli altri Canti, con lui.</l> 
					<l xml:id="23"><seg ana="#inter">Piova</seg>, sull'arido.</l> 
				</lg>
			</lg>
